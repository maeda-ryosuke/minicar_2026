    <!-- lidar/imu 付きミニカー(別ファイル models/tt02 を include)。TT-02 実寸(全長~0.38m)。
         モデル原点は地面レベルなので spawn z は僅かに浮かせて着地。
         スポーン位置はコース下段の開けた場所(要調整)。GZ_SIM_RESOURCE_PATH=/worlds/models 必要。 -->
    <include>
      <uri>model://tt02</uri>
      <pose>5.23 1.0 0.05 0 0 0</pose>
    </include>
