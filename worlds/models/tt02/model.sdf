<?xml version="1.0" ?>
<sdf version="1.9">
  <!--
    Tamiya TT-02 相当ミニカー。座標系: モデル原点=前後軸中点の地面レベル(z=0=地面)。
    実寸: wheelbase 0.257m, track 0.166m, tire 直径0.063m(r=0.0315)/幅0.024m。
    トポロジは vehicle_blue と同一(前輪=steering_link経由, 後輪=chassis直付け,
    ホイールは roll -1.5707 で y軸回りに転動, AckermannSteering で駆動+操舵)。
    lidar は前方・地上~0.10m。GZ_SIM_RESOURCE_PATH=/worlds/models で解決。

    摩擦: 既定の物理エンジンは DART なので、車輪の <surface> は <ode> の
    mu/mu2 だけが効く。元は vehicle_blue 由来の <bullet> ブロック(rolling_friction
    が前後で非対称)も付いていたが、DART では一切読まれない死んだ設定だったので
    削除した。転がり抵抗を入れたい場合は関節の <dynamics><friction> を使う。
  -->
  <model name='tt02'>

    <!-- 車体(シャーシ+ボディ相当の箱)。前後軸中点=x0, 地上クリアランス~3cm。 -->
    <link name='chassis'>
      <pose>0 0 0.055 0 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.003125</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.018360</iyy><iyz>0</iyz>
          <izz>0.020860</izz>
        </inertia>
      </inertial>
      <visual name='visual'>
        <geometry><box><size>0.38 0.15 0.05</size></box></geometry>
        <material>
          <ambient>0.15 0.35 0.85 1</ambient>
          <diffuse>0.15 0.35 0.85 1</diffuse>
          <specular>0.1 0.1 0.3 1</specular>
        </material>
      </visual>
      <collision name='collision'>
        <geometry><box><size>0.38 0.15 0.05</size></box></geometry>
      </collision>

      <!-- 2D lidar: 前方(x=0.10)・地上~0.10m。270deg/640サンプル/0.1-30m/10Hz。
           ここはあくまで「センサが何を見えるか」。前方180degへの絞り込みは
           ftg_node 側(cone_half_angle_deg)で行う。実機 TG30 は 360deg で
           全周を返してくるので、絞るのはソフトの仕事にしておく方が
           Sim2Real がずれない。センサ設定で絞ってはいけない。 -->
      <sensor name="gpu_lidar" type="gpu_lidar">
        <pose>0.10 0 0.045 0 0 0</pose>
        <topic>scan</topic>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>640</samples>
              <resolution>1</resolution>
              <min_angle>-2.356</min_angle>
              <max_angle>2.356</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>30.0</max>
            <resolution>0.01</resolution>
          </range>
          <!-- 測距ノイズ。実機 TG30 は TOF なので必ず誤差が乗る。
               ノイズ無しで前処理(移動平均)や MPPI のコストを詰めると、
               実機で総崩れになるため入れておく。
               stddev=0.01(1cm) は f1tenth_gym_ros の lidar_noise_std に
               合わせた暫定値。実機 TG30 を静止させて実測し直すべき値。 -->
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>

      <sensor name="imu" type="imu">
        <pose>0 0 0 0 0 0</pose>
        <topic>imu</topic>
        <update_rate>100</update_rate>
        <always_on>1</always_on>
      </sensor>
    </link>

    <!-- ===== 車輪(cyl: length=幅0.024, radius=0.0315)。roll -1.5707 で軸を y に。 ===== -->
    <link name='front_left_wheel'>
      <pose>0.1285 0.083 0.0315 -1.5707 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>0.0000148</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0000148</iyy><iyz>0</iyz><izz>0.0000248</izz></inertia>
      </inertial>
      <visual name='visual'>
        <geometry><cylinder><length>0.024</length><radius>0.0315</radius></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <collision name='collision'>
        <geometry><cylinder><length>0.024</length><radius>0.0315</radius></cylinder></geometry>
        <surface><friction><ode><mu>0.9</mu><mu2>1.0</mu2><fdir1>0 0 1</fdir1></ode></friction></surface>
      </collision>
    </link>

    <link name='rear_left_wheel'>
      <pose>-0.1285 0.083 0.0315 -1.5707 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>0.0000148</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0000148</iyy><iyz>0</iyz><izz>0.0000248</izz></inertia>
      </inertial>
      <visual name='visual'>
        <geometry><cylinder><length>0.024</length><radius>0.0315</radius></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <collision name='collision'>
        <geometry><cylinder><length>0.024</length><radius>0.0315</radius></cylinder></geometry>
        <surface><friction><ode><mu>0.9</mu><mu2>1.0</mu2><fdir1>0 0 1</fdir1></ode></friction></surface>
      </collision>
    </link>

    <link name='front_right_wheel'>
      <pose>0.1285 -0.083 0.0315 -1.5707 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>0.0000148</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0000148</iyy><iyz>0</iyz><izz>0.0000248</izz></inertia>
      </inertial>
      <visual name='visual'>
        <geometry><cylinder><length>0.024</length><radius>0.0315</radius></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <collision name='collision'>
        <geometry><cylinder><length>0.024</length><radius>0.0315</radius></cylinder></geometry>
        <surface><friction><ode><mu>0.9</mu><mu2>1.0</mu2><fdir1>0 0 1</fdir1></ode></friction></surface>
      </collision>
    </link>

    <link name='rear_right_wheel'>
      <pose>-0.1285 -0.083 0.0315 -1.5707 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>0.0000148</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0000148</iyy><iyz>0</iyz><izz>0.0000248</izz></inertia>
      </inertial>
      <visual name='visual'>
        <geometry><cylinder><length>0.024</length><radius>0.0315</radius></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <collision name='collision'>
        <geometry><cylinder><length>0.024</length><radius>0.0315</radius></cylinder></geometry>
        <surface><friction><ode><mu>0.9</mu><mu2>1.0</mu2><fdir1>0 0 1</fdir1></ode></friction></surface>
      </collision>
    </link>

    <!-- ===== 前輪キングピン(操舵リンク): 前軸・僅かに内側・鉛直軸で操舵 ===== -->
    <link name="front_left_wheel_steering_link">
      <pose>0.1285 0.07 0.0315 0 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia>
      </inertial>
      <visual name="steering_link_visual">
        <geometry><cylinder><length>0.03</length><radius>0.006</radius></cylinder></geometry>
        <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
      </visual>
    </link>

    <link name="front_right_wheel_steering_link">
      <pose>0.1285 -0.07 0.0315 0 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia>
      </inertial>
      <visual name="steering_link_visual">
        <geometry><cylinder><length>0.03</length><radius>0.006</radius></cylinder></geometry>
        <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
      </visual>
    </link>

    <!-- ===== ジョイント ===== -->
    <joint name="front_left_wheel_steering_joint" type="revolute">
      <child>front_left_wheel_steering_link</child>
      <parent>chassis</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <!-- velocity は実機サーボ相当の 10rad/s(≒570deg/s)。1.0 のままだと
             steer_p_gain を上げてもこの上限が律速になって速くならない。 -->
        <limit><lower>-0.6</lower><upper>0.6</upper><velocity>10.0</velocity><effort>5</effort></limit>
      </axis>
    </joint>

    <joint name="front_right_wheel_steering_joint" type="revolute">
      <parent>chassis</parent>
      <child>front_right_wheel_steering_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-0.6</lower><upper>0.6</upper><velocity>10.0</velocity><effort>5</effort></limit>
      </axis>
    </joint>

    <joint name='front_left_wheel_joint' type='revolute'>
      <parent>front_left_wheel_steering_link</parent>
      <child>front_left_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit></axis>
    </joint>

    <joint name='front_right_wheel_joint' type='revolute'>
      <parent>front_right_wheel_steering_link</parent>
      <child>front_right_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit></axis>
    </joint>

    <joint name='rear_left_wheel_joint' type='revolute'>
      <parent>chassis</parent>
      <child>rear_left_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit></axis>
    </joint>

    <joint name='rear_right_wheel_joint' type='revolute'>
      <parent>chassis</parent>
      <child>rear_right_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit></axis>
    </joint>

    <!-- Ackermann 駆動+操舵。cmd_vel(Twist) を /model/tt02/cmd_vel で購読。 -->
    <plugin filename="gz-sim-ackermann-steering-system" name="gz::sim::systems::AckermannSteering">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_wheel_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_wheel_steering_joint</right_steering_joint>
      <kingpin_width>0.14</kingpin_width>
      <steering_limit>0.5</steering_limit>
      <!-- 操舵の応答速度。プラグインは joint速度 = gain*(目標角-現在角) の
           比例制御なので、これは定義上そのまま一次遅れの時定数 tau=1/gain
           になる。既定値 1.0 だと tau=1.0秒 で、10Hz の制御周期に対して
           絶望的に遅い（実測で確認済み: 理論式と誤差1.1%で一致）。
           実機 TT-02 のサーボは 60deg を 0.1〜0.15秒なので 15 で tau=0.067秒。
           注意: 下の操舵関節の <velocity> 上限も一緒に上げないと、
           ゲインを上げてもそちらが律速になって効かない。 -->
      <steer_p_gain>15.0</steer_p_gain>
      <wheel_base>0.257</wheel_base>
      <wheel_separation>0.166</wheel_separation>
      <wheel_radius>0.0315</wheel_radius>
      <min_velocity>-2</min_velocity>
      <max_velocity>5</max_velocity>
      <min_acceleration>-3</min_acceleration>
      <max_acceleration>3</max_acceleration>
    </plugin>

    <!-- 実際の操舵角を外から観測できるようにする（デバッグ・評価用）。
         AckermannSteering は Twist を受けて内部で舵角を作るので、
         「指令どおり切れているか」は指令側からは分からない。
         steer_p_gain 未設定で時定数 1.0 秒になっていた件を実測で見つけた
         ように、指令と実舵角のズレは実際に起きる。ここを直接出す。 -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <joint_name>front_left_wheel_steering_joint</joint_name>
      <joint_name>front_right_wheel_steering_joint</joint_name>
    </plugin>

    <!-- グラウンドトゥルース。評価専用で、制御には絶対に使わない。
         上の AckermannSteering が出す /model/tt02/odometry は、車輪回転と
         操舵角から積分した推測航法であって実測ではない。壁に刺さって車輪が
         空転していても「指令どおり走行中」を報告し続ける(実測: odom が
         0.49rad/s のとき IMU は 0.000)。そのため走行距離や軌跡の評価に
         使うと、止まっている車を「55m 走った」と誤判定する。
         OdometryPublisher はシミュレータ内の真の姿勢から odometry を作るので
         スリップや衝突の影響がそのまま出る。実機には存在しない情報なので、
         制御ノードからは購読しないこと。 -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_topic>/ground_truth/odom</odom_topic>
      <odom_frame>world</odom_frame>
      <robot_base_frame>tt02_gt</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>2</dimensions>
    </plugin>

  </model>
</sdf>
