Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Map (SLAM)1
        - /LaserScan (filtered)1
      SplitterRatio: 0.5
    Tree Height: 700
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 30
      Color: 60; 60; 60
      Alpha: 0.5
      Reference Frame: <Fixed Frame>

    # slam_toolbox が構築中の占有格子。これが出れば地図生成は動いている。
    # Transient Local でないと latch された地図を取り逃がす。
    - Class: rviz_default_plugins/Map
      Name: Map (SLAM)
      Enabled: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: map
      Alpha: 0.7
      Draw Behind: true

    # SLAM に実際に入っている点群。前方180deg・2m に絞られた状態で、
    # 生スキャンとの差が「実機の壁高 0.10m 制約で捨てた分」。
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan (filtered)
      Enabled: true
      Topic:
        Value: /scan_filtered
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 5
      Color: 0; 255; 255
      Color Transformer: FlatColor
      Decay Time: 0

    # 生スキャン(270deg / 30m)。上の水色と重ねると何を捨てたかが見える。
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan (raw)
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 2
      Color: 110; 110; 110
      Color Transformer: FlatColor
      Decay Time: 0

    # ポーズグラフ。ノードが 0.10m 間隔で並び、ループが閉じると
    # 始点と終点が繋がる。誤ループ閉じ込みが起きていないかはここで見る。
    - Class: rviz_default_plugins/MarkerArray
      Name: Pose graph
      Enabled: true
      Topic:
        Value: /slam_toolbox/graph_visualization
        Depth: 10
        Durability Policy: Volatile
        Reliability Policy: Reliable

    # 真の軌跡(緑)。SLAM 地図が歪んでいれば、この軌跡と地図がずれる。
    - Class: rviz_default_plugins/Path
      Name: Path (ground truth)
      Enabled: true
      Topic:
        Value: /viz/path_true
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 0; 255; 0
      Line Style: Lines
      Alpha: 1

    # map -> odom -> base_link -> laser が繋がっているかの確認用。
    # SLAM が動かないときはまずここを見る。
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Marker Scale: 0.3

  Global Options:
    # 地図作成中は map に固定する。world にすると world -> map の静的TF
    # 越しになり、SLAM が地図をどう置いたかが見えにくい。
    Fixed Frame: map
    Background Color: 25; 25; 30
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 14
      Pitch: 1.4
      Yaw: 4.7
      Focal Point:
        X: 3
        Y: 1.5
        Z: 0
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1500
